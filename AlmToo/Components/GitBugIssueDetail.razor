@using AlmToo.Managers.GitBug

@if (State.SelectedIssue is { } issue)
{
    <article class="gitbug-detail" aria-labelledby="gitbug-detail-heading">
        <button class="gitbug-back" type="button" @onclick="OnBackRequested" disabled="@State.IsBusy">
            <span aria-hidden="true">←</span> Back to issues
        </button>

        <header class="gitbug-detail__header">
            <p class="gitbug-eyebrow">Git-Bug issue detail</p>
            <h2 id="gitbug-detail-heading">@issue.Summary.Title</h2>
            <div class="gitbug-detail__metadata">
                <span class="gitbug-state gitbug-state--@issue.Summary.State.ToString().ToLowerInvariant()">@issue.Summary.State</span>
                @if (!string.IsNullOrWhiteSpace(issue.Summary.AuthorDisplayName))
                {
                    <span>Opened by @issue.Summary.AuthorDisplayName</span>
                }
            </div>
            @if (issue.Summary.Labels is { Count: > 0 })
            {
                <div class="gitbug-labels" aria-label="Labels">
                    @foreach (var label in issue.Summary.Labels)
                    {
                        <span class="gitbug-label">@label</span>
                    }
                </div>
            }
        </header>

        <p class="gitbug-local-boundary" role="note">
            Changes are saved only to this browser-local Git-Bug workspace. No remote push is performed.
        </p>

        @if (!string.IsNullOrWhiteSpace(State.Message) && State.LastWriteSucceeded is not true)
        {
            <div class="gitbug-inline-message" role="@(State.Status == GitBugWorkspaceStatus.Failed ? "alert" : "status")" aria-live="polite">
                @State.Message
            </div>
        }

        <section class="gitbug-edit-panel" aria-labelledby="gitbug-edit-heading">
            <div class="gitbug-section-heading">
                <h3 id="gitbug-edit-heading">Edit issue</h3>
                <p>Update the title and description locally for review.</p>
            </div>
            <form class="gitbug-form" @onsubmit="SubmitEditAsync" @onsubmit:preventDefault="true">
                <div class="gitbug-form__field">
                    <label for="gitbug-edit-title">Title</label>
                    <input id="gitbug-edit-title" name="title" type="text" maxlength="256" required
                           @bind="editTitle" disabled="@State.IsBusy" />
                </div>
                <div class="gitbug-form__field">
                    <label for="gitbug-edit-description">Description</label>
                    <textarea id="gitbug-edit-description" name="description" maxlength="16384" rows="6"
                              @bind="editDescription" disabled="@State.IsBusy"></textarea>
                </div>
                <div class="gitbug-form__actions">
                    <button class="gitbug-action" type="submit" disabled="@State.IsBusy">@(State.Status == GitBugWorkspaceStatus.EditingIssue ? "Saving…" : "Save issue locally")</button>
                    <button class="gitbug-secondary-action" type="button" @onclick="ResetDrafts" disabled="@State.IsBusy">Cancel</button>
                </div>
            </form>
        </section>

        <section class="gitbug-commit-panel" aria-labelledby="gitbug-commit-heading">
            <div class="gitbug-section-heading">
                <h3 id="gitbug-commit-heading">Review local commit</h3>
                <p>Inspect changed files before preparing a browser-local commit. Review does not mutate the repository.</p>
            </div>
            @if (!State.CommitReviewLoaded)
            {
                <button class="gitbug-action" type="button" @onclick="RequestCommitReviewAsync" disabled="@State.IsBusy">
                    @(State.Status == GitBugWorkspaceStatus.LoadingCommitReview ? "Loading changed files…" : "Review changed files")
                </button>
            }
            else
            {
                <div class="gitbug-commit-review" aria-live="polite">
                    <h4>Changed files (@State.ChangedFiles.Count)</h4>
                    @if (State.ChangedFiles.Count == 0)
                    {
                        <p class="gitbug-empty">There are no changed files to commit.</p>
                    }
                    else
                    {
                        <ul class="gitbug-changed-files" aria-label="Changed files">
                            @foreach (var file in State.ChangedFiles)
                            {
                                <li><code>@file.Path</code><span class="gitbug-change-kind">@file.ChangeKind</span></li>
                            }
                        </ul>
                    }
                </div>

                <form class="gitbug-form gitbug-commit-form" @onsubmit="PrepareCommitAsync" @onsubmit:preventDefault="true">
                    <div class="gitbug-form__field">
                        <label for="gitbug-commit-message">Commit message</label>
                        <input id="gitbug-commit-message" name="commit-message" type="text" maxlength="4096" required
                               @bind="commitMessage" disabled="@State.IsBusy" />
                    </div>
                    <div class="gitbug-form__field">
                        <label for="gitbug-commit-author">Author name</label>
                        <input id="gitbug-commit-author" name="commit-author" type="text" maxlength="512" required
                               @bind="commitAuthor" disabled="@State.IsBusy" />
                    </div>
                    <div class="gitbug-form__field">
                        <label for="gitbug-commit-email">Author email</label>
                        <input id="gitbug-commit-email" name="commit-email" type="email" maxlength="512" required
                               @bind="commitEmail" disabled="@State.IsBusy" />
                    </div>
                    <div class="gitbug-form__actions">
                        <button class="gitbug-secondary-action" type="submit" disabled="@State.IsBusy">
                            Prepare commit details
                        </button>
                    </div>
                </form>

                @if (State.ProposedCommit is not null
                    && State.Status == GitBugWorkspaceStatus.CommitReviewReady
                    && State.CanConfirmCommit)
                {
                    <div class="gitbug-commit-confirmation" role="group" aria-labelledby="gitbug-confirm-heading">
                        <h4 id="gitbug-confirm-heading">Confirm local commit</h4>
                        <p id="gitbug-confirm-description">Creating this commit changes only this browser-local repository. This action will not push to a remote.</p>
                        <button class="gitbug-action" type="button" aria-describedby="gitbug-confirm-description" @onclick="ConfirmCommitAsync" disabled="@State.IsBusy">
                            Confirm and create local commit
                        </button>
                    </div>
                }

                @if (State.Status == GitBugWorkspaceStatus.CommitSucceeded && State.LastCommit is { } commit)
                {
                    <p class="gitbug-save-status" role="status" aria-live="polite">
                        Local commit created: <code>@commit.CommitId</code> (@commit.ChangedFileCount changed files). No push was performed.
                    </p>
                }
            }
        </section>

        @if (State.LastCommit is not null)
        {
            <section class="gitbug-push-panel" aria-labelledby="gitbug-push-heading">
                <div class="gitbug-section-heading">
                    <h3 id="gitbug-push-heading">Review and push commit</h3>
                    <p>Push is a separate, explicit action. The credential is kept only for this browser tab and is never displayed or logged.</p>
                </div>

                @if (!State.PushReviewLoaded && State.Status != GitBugWorkspaceStatus.Pushing)
                {
                    <button class="gitbug-action" type="button" @onclick="RequestPushReviewAsync" disabled="@State.IsBusy">
                        @(State.Status == GitBugWorkspaceStatus.LoadingPushReview ? "Loading push target…" : "Review push target")
                    </button>
                }

                @if (State.PushReview is { } pushReview)
                {
                    <dl class="gitbug-push-review" aria-label="Push target review">
                        <div><dt>Remote</dt><dd><code>@pushReview.RepositoryUrl</code></dd></div>
                        <div><dt>Branch</dt><dd><code>@pushReview.Branch</code></dd></div>
                        <div><dt>Destination</dt><dd><code>@pushReview.DestinationRef</code></dd></div>
                        <div><dt>Commit</dt><dd><code>@pushReview.OutgoingCommitId</code></dd></div>
                    </dl>
                }

                @if (State.PushReview is not null && (!State.HasCredential || State.CredentialReplacementRequired))
                {
                    <form class="gitbug-form gitbug-credential-form" @onsubmit="SubmitCredentialAsync" @onsubmit:preventDefault="true">
                        <div class="gitbug-form__field">
                            <label for="gitbug-push-credential">Tab-scoped credential</label>
                            <input id="gitbug-push-credential" name="push-credential" type="password"
                                   autocomplete="new-password" spellcheck="false" required
                                   @bind="credential" @bind:event="oninput" disabled="@State.IsBusy" />
                            <small id="gitbug-push-credential-help">Used only for this tab's push attempt. The field is cleared after submission.</small>
                        </div>
                        <div class="gitbug-form__actions">
                            <button class="gitbug-action" type="submit" disabled="@State.IsBusy">@(State.CredentialReplacementRequired ? "Replace credential" : "Use credential")</button>
                        </div>
                    </form>
                }

                @if (State.HasCredential && State.PushReview is not null && !State.PushConfirmed)
                {
                    <div class="gitbug-commit-confirmation" role="group" aria-labelledby="gitbug-push-confirm-heading">
                        <h4 id="gitbug-push-confirm-heading">Confirm remote push</h4>
                        <p id="gitbug-push-confirm-description">Verify the remote, branch, destination, and commit above before continuing.</p>
                        <button class="gitbug-action" type="button" aria-describedby="gitbug-push-confirm-description" @onclick="ConfirmPushAsync" disabled="@State.IsBusy">Confirm push</button>
                    </div>
                }

                @if (State.PushConfirmed && State.PushReview is not null)
                {
                    <button class="gitbug-action" type="button" @onclick="PushAsync" disabled="@State.IsBusy">
                        @(State.Status == GitBugWorkspaceStatus.Pushing ? "Pushing…" : "Push reviewed commit")
                    </button>
                }

                @if (State.Status == GitBugWorkspaceStatus.PushSucceeded)
                {
                    <p class="gitbug-save-status" role="status" aria-live="polite">@State.Message</p>
                }
                @if (State.PushFailureKind is not null)
                {
                    <div class="gitbug-push-recovery" role="alert" aria-live="assertive">
                        <p>@State.Message</p>
                        @if (State.PushFailureKind?.ToString() == "CredentialRejected")
                        {
                            <p>Enter a replacement credential above, then review the target and confirm again.</p>
                        }
                        else
                        {
                            <p>Resolve the remote problem, then review the current target before retrying.</p>
                        }
                        <button class="gitbug-secondary-action" type="button" @onclick="RetryPushAsync" disabled="@State.IsBusy">Review and retry</button>
                    </div>
                }
            </section>
        }

        <section class="gitbug-detail__description" aria-labelledby="gitbug-description-heading">
            <h3 id="gitbug-description-heading">Description</h3>
            @if (string.IsNullOrWhiteSpace(issue.Description))
            {
                <p class="gitbug-empty">No description was provided.</p>
            }
            else
            {
                <p class="gitbug-prose">@issue.Description</p>
            }
        </section>

        <section class="gitbug-comments" aria-labelledby="gitbug-comments-heading">
            <h3 id="gitbug-comments-heading">Comments (@issue.Comments.Count)</h3>
            @if (issue.Comments.Count == 0)
            {
                <p class="gitbug-empty">No comments yet.</p>
            }
            else
            {
                <ol class="gitbug-comments__list">
                    @foreach (var comment in issue.Comments)
                    {
                        <li class="gitbug-comment">
                            <p class="gitbug-comment__author">@comment.AuthorDisplayName</p>
                            <p class="gitbug-prose">@comment.Body</p>
                        </li>
                    }
                </ol>
            }
        </section>

        <section class="gitbug-comment-form" aria-labelledby="gitbug-comment-form-heading">
            <h3 id="gitbug-comment-form-heading">Add a comment</h3>
            <form class="gitbug-form" @onsubmit="SubmitCommentAsync" @onsubmit:preventDefault="true">
                <div class="gitbug-form__field">
                    <label for="gitbug-comment-body">Comment</label>
                    <textarea id="gitbug-comment-body" name="comment" maxlength="16384" rows="4" required
                              @bind="commentBody" disabled="@State.IsBusy"></textarea>
                </div>
                <div class="gitbug-form__actions">
                    <button class="gitbug-action" type="submit" disabled="@State.IsBusy">@(State.Status == GitBugWorkspaceStatus.AddingComment ? "Saving…" : "Add comment locally")</button>
                    <button class="gitbug-secondary-action" type="button" @onclick="ClearComment" disabled="@State.IsBusy">Clear</button>
                </div>
            </form>
        </section>

        @if (State.LastWriteSucceeded is true)
        {
            <p class="gitbug-save-status" role="status" aria-live="polite">@State.Message</p>
        }
    </article>
}

@code {
    private string editTitle = string.Empty;
    private string editDescription = string.Empty;
    private string commentBody = string.Empty;
    private string commitMessage = string.Empty;
    private string commitAuthor = string.Empty;
    private string commitEmail = string.Empty;
    private string credential = string.Empty;
    private string? draftIssueId;

    [Parameter, EditorRequired] public GitBugWorkspaceState State { get; set; } = null!;
    [Parameter] public EventCallback OnBackRequested { get; set; }
    [Parameter] public EventCallback<(string Title, string Description)> OnIssueEdited { get; set; }
    [Parameter] public EventCallback<string> OnCommentAdded { get; set; }
    [Parameter] public EventCallback OnReviewCommitRequested { get; set; }
    [Parameter] public EventCallback OnCommitConfirmed { get; set; }
    [Parameter] public EventCallback<(string Message, string AuthorName, string AuthorEmail)> OnCommitDetailsChanged { get; set; }
    [Parameter] public EventCallback OnReviewPushRequested { get; set; }
    [Parameter] public EventCallback<string> OnCredentialSubmitted { get; set; }
    [Parameter] public EventCallback OnPushConfirmed { get; set; }
    [Parameter] public EventCallback OnPushRequested { get; set; }
    [Parameter] public EventCallback OnRetryPushRequested { get; set; }
    [Parameter] public EventCallback<string> OnCredentialReplacement { get; set; }

    protected override void OnParametersSet()
    {
        if (State.SelectedIssue is { } issue && draftIssueId != issue.Summary.Id.Value)
        {
            draftIssueId = issue.Summary.Id.Value;
            editTitle = issue.Summary.Title;
            editDescription = issue.Description;
            commentBody = string.Empty;
        }

        if (State.ProposedCommit is { } proposed)
        {
            commitMessage = proposed.Message;
            commitAuthor = proposed.AuthorName;
            commitEmail = proposed.AuthorEmail;
        }
    }

    private async Task RequestCommitReviewAsync() => await OnReviewCommitRequested.InvokeAsync();

    private async Task PrepareCommitAsync()
    {
        if (!State.IsBusy)
        {
            await OnCommitDetailsChanged.InvokeAsync((commitMessage, commitAuthor, commitEmail));
        }
    }

    private async Task ConfirmCommitAsync() => await OnCommitConfirmed.InvokeAsync();
    private async Task RequestPushReviewAsync() => await OnReviewPushRequested.InvokeAsync();
    private async Task SubmitCredentialAsync()
    {
        var submitted = credential;
        credential = string.Empty;
        if (!State.IsBusy && !string.IsNullOrWhiteSpace(submitted))
        {
            if (State.CredentialReplacementRequired)
            {
                await OnCredentialReplacement.InvokeAsync(submitted);
            }
            else
            {
                await OnCredentialSubmitted.InvokeAsync(submitted);
            }
        }
    }
    private async Task ConfirmPushAsync() => await OnPushConfirmed.InvokeAsync();
    private async Task PushAsync() => await OnPushRequested.InvokeAsync();
    private async Task RetryPushAsync() => await OnRetryPushRequested.InvokeAsync();
    private async Task ReplaceCredentialAsync()
    {
        var submitted = credential;
        credential = string.Empty;
        if (!State.IsBusy && !string.IsNullOrWhiteSpace(submitted))
        {
            await OnCredentialReplacement.InvokeAsync(submitted);
        }
    }

    private async Task SubmitEditAsync()
    {
        if (!State.IsBusy)
        {
            await OnIssueEdited.InvokeAsync((editTitle, editDescription));
        }
    }

    private async Task SubmitCommentAsync()
    {
        if (!State.IsBusy)
        {
            await OnCommentAdded.InvokeAsync(commentBody);
        }
    }

    private void ResetDrafts()
    {
        if (State.SelectedIssue is { } issue)
        {
            editTitle = issue.Summary.Title;
            editDescription = issue.Description;
        }
    }

    private void ClearComment() => commentBody = string.Empty;
}
