@using AlmToo.Managers.Repositories

<section class="changed-files" aria-labelledby="changed-files-heading">
    <div class="changed-files__header">
        <div><p class="helper-text">Working tree</p><h2 id="changed-files-heading">Changed files</h2></div>
        <button class="changed-files__refresh" type="button" @onclick="OnRefreshRequested" disabled="@State.IsBusy">
            @(IsLoading ? "Refreshing..." : "Refresh")
        </button>
    </div>

    @if (IsLoading)
    {
        <p class="status-message info" role="status" aria-live="polite">Checking working tree status...</p>
    }
    else if (StatusResult is not null)
    {
        <p class="@MessageCssClass" role="status" aria-live="polite">@StatusResult.Message</p>
    }

    @if (!IsLoading && State.ChangedFiles.Count == 0 && StatusResult is null)
    {
        <p class="changed-files__empty">No changed files detected.</p>
    }
    else if (!IsLoading && State.ChangedFiles.Count == 0 && StatusResult?.Succeeded == true)
    {
        <p class="changed-files__empty">Working tree is clean.</p>
    }
    else if (State.ChangedFiles.Count > 0)
    {
        <ul class="changed-files__list" aria-label="Changed file list">
            @foreach (var file in State.ChangedFiles)
            {
                var kind = file.ChangeKind.ToString();
                <li class="changed-files__item">
                    <span class="changed-files__badge changed-files__badge--@kind.ToLowerInvariant()">@(kind == "Unknown" ? "Changed" : kind)</span>
                    <span class="changed-files__path">@file.Path</span>
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter, EditorRequired] public RepositoryWorkspaceState State { get; set; } = null!;
    [Parameter] public EventCallback OnRefreshRequested { get; set; }

    private bool IsLoading => State.Operation == RepositoryWorkspaceOperation.RefreshStatus;
    private RepositoryWorkspaceResult? StatusResult =>
        State.Result?.Operation == RepositoryWorkspaceOperation.RefreshStatus ? State.Result : null;
    private string MessageCssClass => $"status-message {(StatusResult?.Succeeded == true ? "success" : "error")}";
}
