@page "/git-bug"
@* Client composition stays Manager-only; repository write inputs are Manager-owned. *@
@using AlmToo.Components
@using AlmToo.Managers.Workspace
@using AlmToo.Managers.Workspace.Interface
@implements IDisposable
@inject WorkspaceManager Workspace

<PageTitle>Git-Bug Issues</PageTitle>

<main class="gitbug-shell">
    <header class="gitbug-hero">
        <p class="gitbug-eyebrow">Browser-local repository metadata</p>
        <h1>Git-Bug issues</h1>
        <p>Browse issue data from the open repository without changing files, refs, or remote state.</p>
    </header>

    @if (!State.RepositoryAvailable)
    {
        <section class="gitbug-state-panel" aria-labelledby="gitbug-no-repository-heading">
            <h2 id="gitbug-no-repository-heading">Open a repository first</h2>
            <p>Return home and open a browser-local repository before browsing its Git-Bug issues.</p>
            <a class="gitbug-action" href="/">Go to repository browser</a>
        </section>
    }
    else if (State.Status == GitBugWorkspaceStatus.LoadingList)
    {
        <section class="gitbug-state-panel" role="status" aria-live="polite" aria-busy="true">
            <h2>Loading issues</h2>
            <p>Reading Git-Bug metadata from this browser-local repository...</p>
        </section>
    }
    else if (State.Status == GitBugWorkspaceStatus.LoadingDetail)
    {
        <section class="gitbug-state-panel" role="status" aria-live="polite" aria-busy="true">
            <h2>Loading issue detail</h2>
            <p>Reading the selected issue and its comments...</p>
            <button class="gitbug-secondary-action" type="button" @onclick="ReturnToIssueList">Back to issues</button>
        </section>
    }
    else if (State.Status == GitBugWorkspaceStatus.ListReady)
    {
        <GitBugIssueList State="State" OnIssueSelected="OpenIssueAsync" />
    }
    else if (State.SelectedIssue is not null && (State.Status == GitBugWorkspaceStatus.DetailReady
        || State.Status == GitBugWorkspaceStatus.EditingIssue
        || State.Status == GitBugWorkspaceStatus.AddingComment
        || State.Status == GitBugWorkspaceStatus.RefreshingAfterWrite
        || Workspace.State.CommitReviewLoaded
        || Workspace.State.CreatedCommit is not null
        || Workspace.State.PushReview is not null
        || Workspace.State.PublicationReview is not null
        || (Workspace.State.Operation is WorkspaceOperation.ReviewCommit
            or WorkspaceOperation.Commit
            or WorkspaceOperation.ReviewPublication
            or WorkspaceOperation.PublishPublication
            or WorkspaceOperation.InspectPush
            or WorkspaceOperation.StoreCredential
            or WorkspaceOperation.Push)
        || Workspace.State.PushFailureKind is not null
        || Workspace.State.PublicationFailureKind is not null))
    {
        <GitBugIssueDetail State="State"
                           RepositoryState="Workspace.State"
                           OnBackRequested="ReturnToIssueList"
                           OnIssueEdited="EditIssueAsync"
                           OnCommentAdded="AddCommentAsync"
                           OnReviewCommitRequested="ReviewCommitAsync"
                           OnCommitConfirmed="ConfirmCommitAsync"
                           OnCommitDetailsChanged="SetCommitDetails"
                           OnRepositoryRefreshRequested="RefreshRepositoryStatusAsync"
                           OnReviewPushRequested="ReviewPushAsync"
                           OnCredentialSubmitted="SubmitCredentialAsync"
                           OnPushConfirmed="ConfirmPushAsync"
                           OnPushRequested="PushAsync"
                           OnRetryPushRequested="RetryPushAsync"
                           OnCredentialReplacement="ReplaceCredentialAsync"
                           OnPublicationReviewRequested="ReviewPublicationAsync"
                           OnPublicationConfirmed="ConfirmPublicationAsync"
                           OnPublicationRequested="PublishPublicationAsync"
                           OnRetryPublicationRequested="RetryPublicationAsync" />
    }
    else if (State.Status is GitBugWorkspaceStatus.Unavailable or GitBugWorkspaceStatus.Unsupported or GitBugWorkspaceStatus.Failed)
    {
        <section class="gitbug-state-panel gitbug-state-panel--notice"
                 role="@(State.Status == GitBugWorkspaceStatus.Failed ? "alert" : "status")"
                 aria-live="@(State.Status == GitBugWorkspaceStatus.Failed ? "assertive" : "polite")"
                 data-gitbug-state="@State.Status.ToString().ToLowerInvariant()"
                 data-gitbug-failure-kind="@(State.FailureKind?.ToString() ?? string.Empty)">
            <h2>@StatusHeading</h2>
            <p>@State.Message</p>
            <div class="gitbug-state-panel__actions">
                @if (State.SelectedIssueId is not null)
                {
                    <button class="gitbug-secondary-action" type="button" @onclick="ReturnToIssueList">Back to issues</button>
                }
                @if (State.CanRetry)
                {
                    <button class="gitbug-action" type="button" @onclick="RetryAsync" disabled="@State.IsBusy">Try again</button>
                }
            </div>
        </section>
    }
    else
    {
        <section class="gitbug-state-panel" aria-labelledby="gitbug-ready-heading">
            <h2 id="gitbug-ready-heading">Issues ready to load</h2>
            <button class="gitbug-action" type="button" @onclick="LoadIssuesAsync">Load issues</button>
        </section>
    }
</main>

@code {
    private bool disposed;
    private GitBugState State => Workspace.State.GitBug;
    private string StatusHeading => State.Status switch
    {
        GitBugWorkspaceStatus.Unavailable => "Git-Bug data unavailable",
        GitBugWorkspaceStatus.Unsupported => "Git-Bug version unsupported",
        _ => "Git-Bug issues could not be loaded"
    };

    protected override async Task OnInitializedAsync()
    {
        Workspace.StateChanged += HandleStateChanged;
        await SynchronizeRepositoryAsync();
    }

    private async Task SynchronizeRepositoryAsync()
    {
        if (State.RepositoryAvailable && State.Status == GitBugWorkspaceStatus.Idle)
        {
            await Workspace.LoadIssuesAsync();
        }
    }

    private async Task LoadIssuesAsync() => await Workspace.LoadIssuesAsync();
    private async Task OpenIssueAsync(string issueId) => await Workspace.OpenIssueAsync(issueId);
    private async Task EditIssueAsync((string Title, string Description) draft)
    {
        if (await Workspace.EditSelectedIssueAsync(draft.Title, draft.Description))
        {
            await Workspace.RefreshStatusAsync();
        }
    }
    private async Task AddCommentAsync(string body)
    {
        if (await Workspace.AddCommentToSelectedIssueAsync(body))
        {
            await Workspace.RefreshStatusAsync();
        }
    }
    private async Task RefreshRepositoryStatusAsync() => await Workspace.RefreshStatusAsync();
    private async Task ReviewCommitAsync() => await Workspace.ReviewCommitAsync();
    private async Task ConfirmCommitAsync() => await Workspace.ConfirmLocalCommitAsync();
    private void SetCommitDetails((string Message, string AuthorName, string Email) details) =>
        Workspace.SetProposedCommit(new WorkspaceCommitInput(details.Message, details.AuthorName, details.Email));
    private async Task ReviewPushAsync() => await Workspace.InspectPushAsync();
    private async Task SubmitCredentialAsync(string credential) => await Workspace.StoreCredentialAsync(credential);
    private void ConfirmPushAsync() => Workspace.ConfirmPushReview(true);
    private async Task PushAsync()
    {
        if (Workspace.State.PushReview is { } review)
        {
            await Workspace.PushReviewedCommitAsync(review);
        }
    }
    private async Task RetryPushAsync() => await Workspace.InspectPushAsync();
    private async Task ReviewPublicationAsync() => await Workspace.ReviewPublicationAsync();
    private void ConfirmPublicationAsync() => Workspace.ConfirmPublicationReview(true);
    private async Task PublishPublicationAsync()
    {
        await Workspace.PublishReviewedPublicationAsync();
    }
    private async Task RetryPublicationAsync() => await Workspace.ReviewPublicationAsync();
    private async Task ReplaceCredentialAsync(string credential) => await Workspace.StoreCredentialAsync(credential);
    private void ReturnToIssueList() => Workspace.ReturnToIssueList();

    private async Task RetryAsync()
    {
        if (State.SelectedIssueId is { } selectedIssueId)
        {
            await Workspace.OpenIssueAsync(selectedIssueId.Value);
        }
        else
        {
            await Workspace.LoadIssuesAsync();
        }
    }

    private void HandleStateChanged()
    {
        if (!disposed)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        disposed = true;
        Workspace.StateChanged -= HandleStateChanged;
        Workspace.CancelCurrentOperation();
    }
}
