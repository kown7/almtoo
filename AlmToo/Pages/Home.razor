@page "/"
@using AlmToo.Managers.Workspace
@using AlmToo.Managers.Workspace.Interface
@implements IDisposable
@inject WorkspaceManager Workspace
@inject NavigationManager Navigation

<PageTitle>Repository Browser</PageTitle>

<section class="repository-shell">
    <div class="repository-hero">
        <p class="helper-text">Browser-local Git workspace</p>
        <h1>Open a public repository</h1>
        <p>Clone a public Git repository into local browser storage, or reopen its existing browser-local workspace.</p>
    </div>

    <div class="repository-card">
        <form class="repository-form" @onsubmit="OpenRepositoryAsync" @onsubmit:preventDefault="true">
            <div class="form-field">
                <label for="repository-url">Repository URL</label>
                <input id="repository-url" name="repository-url" type="url"
                       placeholder="https://github.com/example/project.git" autocomplete="url"
                       @bind="repositoryUrl" disabled="@State.IsBusy" />
                <p class="field-help">Public HTTPS Git URLs work best in browser-local storage.</p>
            </div>
            <button class="primary-action" type="submit" disabled="@State.IsBusy">
                @(IsOperation(WorkspaceOperation.OpenRepository) ? "Opening..." : "Open repository")
            </button>
        </form>

        @if (State.Repository is null && State.AvailableRepositories.Count > 1)
        {
            <section class="local-repositories" aria-labelledby="local-repositories-heading">
                <h2 id="local-repositories-heading">Reopen an existing repository</h2>
                <p class="field-help">This browser has more than one local repository. Choose one to continue where you left off.</p>
                <div class="local-repository-list">
                    @foreach (var repository in State.AvailableRepositories)
                    {
                        <button class="secondary-action local-repository-choice" type="button"
                                @onclick="() => OpenExistingRepositoryAsync(repository.RepositoryUrl)"
                                disabled="@State.IsBusy">
                            @repository.RepositoryUrl
                        </button>
                    }
                </div>
            </section>
        }

        @if (IsOperation(WorkspaceOperation.OpenRepository))
        {
            <p class="status-message info" role="status" aria-live="polite">Contacting the Git host and preparing browser storage...</p>
        }
        else if (State.Repository is null && State.Result is not null)
        {
            <p class="@ResultCssClass"
               role="@(State.Result.Succeeded ? "status" : "alert")"
               aria-live="@(State.Result.Succeeded ? "polite" : "assertive")">@State.Result.Message</p>
        }
    </div>

    @if (State.IsBusy)
    {
        <button class="secondary-action" type="button" @onclick="Workspace.CancelCurrentOperation">Cancel current operation</button>
    }

    @if (State.Repository is null && (State.HasCredential || State.CredentialReplacementRequired))
    {
        <section class="credential-reload-state" aria-label="Push credential status">
            @if (State.HasCredential)
            {
                <p data-credential-state="present">A token is available for an explicit push in this tab.</p>
                <button class="secondary-action" type="button" @onclick="ForgetCredentialAsync" disabled="@State.IsBusy">Forget token</button>
            }
            @if (State.Result?.Operation is WorkspaceOperation.InitializeCredential
                or WorkspaceOperation.StoreCredential
                or WorkspaceOperation.ForgetCredential)
            {
                <p class="@ResultCssClass" data-credential-state="@CredentialState" role="status" aria-live="polite">@State.Result.Message</p>
            }
        </section>
    }

    @if (State.ApprovedProxyOptions.Count > 0)
    {
        <section class="proxy-policy-card" aria-labelledby="proxy-policy-heading">
            <div>
                <p class="helper-text">Approved browser transport</p>
                <h2 id="proxy-policy-heading">Choose a Git connection</h2>
                <p class="field-help">Only connections approved by the application are available. Proxy endpoints are never entered on this page.</p>
            </div>
            <label for="proxy-selector">Approved connection</label>
            <select id="proxy-selector" @onchange="SelectProxyAsync" disabled="@State.IsBusy">
                <option value="">Choose an approved connection</option>
                @foreach (var option in State.ApprovedProxyOptions)
                {
                    <option value="@option.Id" selected="@(State.SelectedProxy?.ProxyId == option.Id)">@option.DisplayName</option>
                }
            </select>
            @if (State.SelectedProxy is not null && !State.ProxyApproved)
            {
                <button class="primary-action" type="button" @onclick="ApproveProxyAsync" disabled="@State.IsBusy">
                    @(IsOperation(WorkspaceOperation.ApproveProxy) ? "Approving..." : "Approve connection")
                </button>
            }
            @if (State.ProxyApproved)
            {
                <p class="status-message success" data-proxy-approval="approved" role="status">Connection approved for this workspace.</p>
            }
            else if (State.RouteBlockReason == WorkspaceRouteBlockReason.ProxySelectionRequired)
            {
                <p class="status-message info" data-proxy-approval="selection-required" role="status">Select an approved connection before entering the workspace.</p>
            }
            else if (State.RouteBlockReason == WorkspaceRouteBlockReason.ProxyApprovalRequired)
            {
                <p class="status-message info" data-proxy-approval="approval-required" role="status">Explicit approval is required before Git operations can run.</p>
            }
        </section>

        @if (State.Repository is not null)
        {
            <section class="workspace-entry-card" aria-labelledby="workspace-entry-heading">
            <div>
                <p class="helper-text">Dedicated repository workspace</p>
                <h2 id="workspace-entry-heading">Continue to the workspace</h2>
                <p class="field-help">Repository browsing, editing, branch history, synchronization, Git-Bug, and publication are available on the workspace page.</p>
            </div>
            <button class="primary-action" type="button" @onclick="OpenWorkspaceAsync"
                    disabled="@(State.IsBusy || State.RouteBlockReason != WorkspaceRouteBlockReason.None)">
                @(IsOperation(WorkspaceOperation.NavigateToWorkspace) ? "Opening workspace..." : "Open workspace")
            </button>
            @if (State.Result?.Operation is WorkspaceOperation.NavigateToWorkspace)
            {
                <p class="@ResultCssClass" role="@(State.Result.Succeeded ? "status" : "alert")">@State.Result.Message</p>
            }
            </section>
        }
    }
</section>

@code {
    private string repositoryUrl = string.Empty;
    private string credentialInput = string.Empty;
    private WorkspaceState State => Workspace.State;
    private bool IsOperation(WorkspaceOperation operation) => State.Operation == operation;
    private string ResultCssClass => $"status-message {(State.Result?.Succeeded == true ? "success" : "error")}";
    private string CredentialState => State.CredentialReplacementRequired ? "replacement-required" : State.HasCredential ? "present" : "forgotten";

    protected override void OnInitialized() => Workspace.StateChanged += HandleStateChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Workspace.InitializeWorkspaceAsync();
        }
    }

    private async Task OpenRepositoryAsync()
    {
        if (await Workspace.OpenRepositoryAsync(repositoryUrl))
        {
            repositoryUrl = string.Empty;
        }
    }

    private Task OpenExistingRepositoryAsync(string url) => OpenRepositoryAndClearAsync(url);

    private async Task OpenRepositoryAndClearAsync(string url)
    {
        if (await Workspace.OpenRepositoryAsync(url))
        {
            repositoryUrl = string.Empty;
        }
    }

    private Task ForgetCredentialAsync() => Workspace.ForgetCredentialAsync();

    private Task SelectProxyAsync(ChangeEventArgs args) =>
        Workspace.SelectProxyAsync(args.Value?.ToString() ?? string.Empty);

    private async Task ApproveProxyAsync()
    {
        if (State.SelectedProxy is not null)
        {
            await Workspace.ApproveProxyAsync(State.SelectedProxy.ProxyId);
        }
    }

    private async Task OpenWorkspaceAsync()
    {
        if (await Workspace.NavigateToWorkspaceAsync())
        {
            Navigation.NavigateTo("/workspace");
        }
    }

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Workspace.StateChanged -= HandleStateChanged;
}
