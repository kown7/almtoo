@page "/"
@using AlmToo.Components
@using AlmToo.Managers.Repositories
@implements IDisposable
@inject RepositoryWorkspaceManager Workspace

<PageTitle>Repository Browser</PageTitle>

<section class="repository-shell">
    <div class="repository-hero">
        <p class="helper-text">Browser-local Git workspace</p>
        <h1>Open a public repository</h1>
        <p>Clone a public Git repository into local browser storage, or reopen its existing browser-local workspace.</p>
    </div>

    <div class="repository-card">
        <form class="repository-form" @onsubmit="OpenRepositoryAsync" @onsubmit:preventDefault="true">
            <div class="form-field">
                <label for="repository-url">Repository URL</label>
                <input id="repository-url" name="repository-url" type="url"
                       placeholder="https://github.com/example/project.git" autocomplete="url"
                       @bind="repositoryUrl" disabled="@State.IsBusy" />
                <p class="field-help">Public HTTPS Git URLs work best in browser-local storage.</p>
            </div>
            <button class="primary-action" type="submit" disabled="@State.IsBusy">
                @(IsOperation(RepositoryWorkspaceOperation.OpenRepository) ? "Opening..." : "Open repository")
            </button>
        </form>

        @if (IsOperation(RepositoryWorkspaceOperation.OpenRepository))
        {
            <p class="status-message info" role="status" aria-live="polite">Contacting the Git host and preparing browser storage...</p>
        }
        else if (State.Repository is null && State.Result is not null)
        {
            <p class="@ResultCssClass"
               role="@(State.Result.Succeeded ? "status" : "alert")"
               aria-live="@(State.Result.Succeeded ? "polite" : "assertive")">@State.Result.Message</p>
        }
    </div>

    @if (State.IsBusy)
    {
        <button class="secondary-action" type="button" @onclick="Workspace.CancelCurrentOperation">Cancel current operation</button>
    }

    @if (State.Repository is null && (State.HasCredential || State.CredentialReplacementRequired))
    {
        <section class="credential-reload-state" aria-label="Push credential status">
            @if (State.HasCredential)
            {
                <p data-credential-state="present">A token is available for an explicit push in this tab.</p>
                <button class="secondary-action" type="button" @onclick="ForgetCredentialAsync" disabled="@State.IsBusy">Forget token</button>
            }
            @if (State.Result?.Operation is RepositoryWorkspaceOperation.InitializeCredential
                or RepositoryWorkspaceOperation.StoreCredential
                or RepositoryWorkspaceOperation.ForgetCredential)
            {
                <p class="@ResultCssClass" data-credential-state="@CredentialState" role="status" aria-live="polite">@State.Result.Message</p>
            }
        </section>
    }

    @if (State.Repository is not null)
    {
        <section class="repository-status" aria-labelledby="repository-status-heading">
            <div><p class="helper-text">Current repository state</p><h2 id="repository-status-heading">Repository ready</h2></div>
            <dl class="status-grid">
                <div><dt>Repository</dt><dd>@State.Repository.RepositoryUrl</dd></div>
                <div><dt>Workspace</dt><dd>@State.Repository.WorkspaceName</dd></div>
                <div><dt>Storage path</dt><dd>@State.Repository.RootPath</dd></div>
                <div><dt>Clone status</dt><dd>@(State.Repository.WasCloned ? "Cloned in this session" : "Opened from browser storage")</dd></div>
                <div><dt>Selected file</dt><dd>@(State.SelectedFilePath ?? "None selected")</dd></div>
                <div><dt>Save status</dt><dd>@SaveStatusText</dd></div>
            </dl>
        </section>

        <RepositoryFileBrowser State="State"
                               OnDirectorySelected="LoadDirectoryAsync"
                               OnFileSelected="SelectFileAsync" />

        <RepositoryChangedFiles State="State" OnRefreshRequested="RefreshStatusAsync" />

        <RepositoryCommitForm State="State" OnCommitRequested="CommitAsync" />

        <section class="push-panel" aria-labelledby="push-heading">
            <div class="push-panel__heading">
                <div><p class="helper-text">Remote write</p><h2 id="push-heading">Push local commit to GitHub</h2></div>
                <button class="secondary-action" type="button" @onclick="InspectPushAsync" disabled="@State.IsBusy">
                    @(IsOperation(RepositoryWorkspaceOperation.InspectPush) ? "Reviewing..." : "Review push")
                </button>
            </div>

            <section class="push-credential" aria-labelledby="push-credential-heading">
                <div class="push-credential__heading">
                    <div><h3 id="push-credential-heading">Push credential</h3><p class="field-help">The token stays only in this browser tab and its value is never displayed.</p></div>
                    @if (State.HasCredential)
                    {
                        <button class="secondary-action" type="button" @onclick="ForgetCredentialAsync" disabled="@State.IsBusy">Forget token</button>
                    }
                </div>
                @if (State.HasCredential)
                {
                    <p class="credential-presence" data-credential-state="present">A token is available for an explicit push in this tab.</p>
                }
                <form class="credential-form" @onsubmit="StoreCredentialAsync" @onsubmit:preventDefault="true">
                    <div class="form-field">
                        <label for="github-pat">GitHub personal access token</label>
                        <input id="github-pat" name="github-pat" type="password" value="@credentialInput"
                               @oninput="UpdateCredentialInput" autocomplete="off" spellcheck="false"
                               disabled="@(State.HasCredential || State.IsBusy)" />
                        <p class="field-help">@(State.HasCredential ? "A retained token is present; its value is not restored to this input." : "Use in this tab stores the token in tab-scoped session storage. The input is cleared immediately.")</p>
                    </div>
                    @if (!State.HasCredential)
                    {
                        <button class="secondary-action" type="submit" disabled="@(State.IsBusy || string.IsNullOrWhiteSpace(credentialInput))">
                            @(IsOperation(RepositoryWorkspaceOperation.StoreCredential) ? "Saving..." : "Use token in this tab")
                        </button>
                    }
                </form>
                @if (State.Result?.Operation is RepositoryWorkspaceOperation.StoreCredential or RepositoryWorkspaceOperation.ForgetCredential)
                {
                    <p class="@ResultCssClass" data-credential-state="@CredentialState" role="status" aria-live="polite">@State.Result.Message</p>
                }
            </section>

            @if (State.PushReview is not null)
            {
                <dl class="push-review" aria-label="Push destination review">
                    <div><dt>GitHub origin</dt><dd data-push-review="origin">@State.PushReview.RepositoryUrl</dd></div>
                    <div><dt>Branch</dt><dd data-push-review="branch">@State.PushReview.Branch</dd></div>
                    <div><dt>Destination ref</dt><dd data-push-review="destination">@State.PushReview.DestinationRef</dd></div>
                    <div><dt>Outgoing commit SHA</dt><dd class="push-review__sha" data-push-review="sha">@State.PushReview.OutgoingCommitId</dd></div>
                </dl>
                <form class="push-form" @onsubmit="PushReviewedCommitAsync" @onsubmit:preventDefault="true">
                    <label class="push-confirmation" for="confirm-push">
                        <input id="confirm-push" type="checkbox" checked="@State.PushConfirmed" @onchange="ConfirmPushReview" disabled="@State.IsBusy" />
                        <span>I confirm this exact commit may be pushed to the reviewed origin and branch.</span>
                    </label>
                    <button class="primary-action" type="submit" disabled="@(!CanPush)">
                        @(IsOperation(RepositoryWorkspaceOperation.Push) ? "Pushing..." : "Push reviewed commit")
                    </button>
                </form>
            }
            else
            {
                <p class="push-panel__placeholder">Review the active origin, branch, destination ref, and commit before confirmation can be entered.</p>
            }

            @if (State.Result?.Operation is RepositoryWorkspaceOperation.InspectPush or RepositoryWorkspaceOperation.Push)
            {
                <p class="@ResultCssClass" data-push-failure="@State.PushFailureCategory"
                   role="@(State.PushFailureCategory is null ? "status" : "alert")"
                   aria-live="@(State.PushFailureCategory is null ? "polite" : "assertive")">@State.Result.Message</p>
            }
        </section>

        <section class="file-preview file-editor" aria-labelledby="file-editor-heading">
            <div><p class="helper-text">Selected file path</p><h2 id="file-editor-heading">@(State.SelectedFilePath ?? "No file selected")</h2></div>
            @if (IsOperation(RepositoryWorkspaceOperation.LoadFile))
            {
                <p class="status-message info" role="status" aria-live="polite">Loading selected text file...</p>
            }
            @if (State.Result?.Operation is RepositoryWorkspaceOperation.LoadFile or RepositoryWorkspaceOperation.SaveFile)
            {
                <p class="@ResultCssClass" role="status" aria-live="polite">@State.Result.Message</p>
            }
            @if (State.SelectedFileContent is not null)
            {
                <div class="file-editor__field">
                    <label for="selected-file-content">Plain text editor</label>
                    <textarea id="selected-file-content" class="file-editor__textarea" spellcheck="false"
                              value="@State.EditableFileContent" @oninput="EditSelectedFile" disabled="@State.IsBusy"></textarea>
                </div>
                <div class="file-editor__actions">
                    <button class="primary-action" type="button" @onclick="SaveSelectedFileAsync" disabled="@(State.IsBusy || !State.HasUnsavedChanges)">
                        @(IsOperation(RepositoryWorkspaceOperation.SaveFile) ? "Saving..." : "Save changes")
                    </button>
                    <p class="file-editor__dirty-state">@(State.HasUnsavedChanges ? "Unsaved edits" : "No unsaved edits")</p>
                </div>
            }
            else if (State.SelectedFilePath is null && !IsOperation(RepositoryWorkspaceOperation.LoadFile))
            {
                <p class="file-preview__placeholder">Choose a text file from the browser to load the editor. Binary or oversized files stay disabled.</p>
            }
        </section>
    }
</section>

@code {
    private string repositoryUrl = string.Empty;
    private string credentialInput = string.Empty;
    private RepositoryWorkspaceState State => Workspace.State;
    private bool IsOperation(RepositoryWorkspaceOperation operation) => State.Operation == operation;
    private bool CanPush => State.PushReview is not null && State.PushConfirmed && State.HasCredential && !State.IsBusy;
    private string ResultCssClass => $"status-message {(State.Result?.Succeeded == true ? "success" : "error")}";
    private string CredentialState => State.CredentialReplacementRequired ? "replacement-required" : State.HasCredential ? "present" : "forgotten";
    private string SaveStatusText => IsOperation(RepositoryWorkspaceOperation.SaveFile) ? "Saving changes" : State.HasUnsavedChanges ? "Unsaved edits" : "No unsaved edits";

    protected override void OnInitialized() => Workspace.StateChanged += HandleStateChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Workspace.InitializeCredentialStateAsync();
        }
    }

    private async Task OpenRepositoryAsync() => await Workspace.OpenRepositoryAsync(repositoryUrl);
    private async Task LoadDirectoryAsync(string path) => await Workspace.LoadDirectoryAsync(path);
    private async Task SelectFileAsync(string path) => await Workspace.SelectFileAsync(path);
    private async Task SaveSelectedFileAsync() => await Workspace.SaveSelectedFileAsync();
    private async Task RefreshStatusAsync() => await Workspace.RefreshStatusAsync();
    private async Task CommitAsync(RepositoryCommitInput input) => await Workspace.CommitAsync(input);
    private async Task InspectPushAsync() => await Workspace.InspectPushAsync();
    private async Task ForgetCredentialAsync() => await Workspace.ForgetCredentialAsync();
    private void EditSelectedFile(ChangeEventArgs args) => Workspace.EditSelectedFile(args.Value?.ToString() ?? string.Empty);
    private void ConfirmPushReview(ChangeEventArgs args) => Workspace.ConfirmPushReview(args.Value is true || string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase));
    private void UpdateCredentialInput(ChangeEventArgs args) => credentialInput = args.Value?.ToString() ?? string.Empty;

    private async Task StoreCredentialAsync()
    {
        var credentialForAttempt = credentialInput;
        credentialInput = string.Empty;
        await Workspace.StoreCredentialAsync(credentialForAttempt);
        credentialForAttempt = string.Empty;
    }

    private async Task PushReviewedCommitAsync()
    {
        if (State.PushReview is not null)
        {
            await Workspace.PushReviewedCommitAsync(State.PushReview);
        }
    }

    private void HandleStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Workspace.StateChanged -= HandleStateChanged;
}
